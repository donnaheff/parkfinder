# ParkSwift feature flags
# Set a flag to true to enable that sovereign/next-stage module in the UI.
# The static browser preview cannot read .env directly, so run scripts/sync-env.js
# after editing this file to regenerate assets/env.js.

FEATURE_V2I_HANDOFF=false
FEATURE_CURB_MANAGEMENT=false
FEATURE_EVENT_SURGE_PLANNING=false
FEATURE_CARBON_REPORTING=false
FEATURE_OPEN_API_MARKETPLACE=false
FEATURE_FRAUD_SPOOFING_DEFENSE=false

# Sovereign platform controls and governance modules
