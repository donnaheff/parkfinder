{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/pitch", "destination": "/investor-pitch.html" },
    { "source": "/phases", "destination": "/phases.html" }
  ],
  "redirects": [
    { "source": "/poc", "destination": "/", "permanent": true },
    { "source": "/app", "destination": "/", "permanent": true },
    { "source": "/backend-demo", "destination": "/admin", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
